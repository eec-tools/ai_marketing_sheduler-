{
  "manifest_version": 3,
  "name": "AI Marketing Scheduler - ChatGPT Companion",
  "version": "1.0.0",
  "description": "Automates DALL-E image generation using your active ChatGPT web session for the AI Marketing Scheduler dashboard.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "notifications",
    "tabs",
    "cookies",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "debugger"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://*.oaiusercontent.com/*",
    "https://files.oaiusercontent.com/*",
    "https://*.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AI Marketing Scheduler Companion"
  }
}
